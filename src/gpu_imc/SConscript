Import('*')

# 1. Register the SimObject definition
SimObject('DigitalIMC.py', sim_objects=['DigitalIMC'])
SimObject('IMCDriver.py', sim_objects=['IMCDriver'])

# 2. Register the C++ Source code
Source('digital_imc.cc')
Source('imc_driver.cc')

# 3. Register the Debug Flag
# This allows you to run with: --debug-flags=DigitalIMC
DebugFlag('DigitalIMC')
